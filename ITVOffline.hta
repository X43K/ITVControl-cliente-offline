<html lang="es">

<head>

<title>ITVControl ERP 4.5</title>

<meta http-equiv="Content-Type" content="text/html; charset=utf-8">

<HTA:APPLICATION
    APPLICATIONNAME="ITVControl offline"
    BORDER="thick"
    SCROLL="yes"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
/>

<style>
body{font-family:Arial;margin:10px;background:#9db5cf no-repeat center center fixed;background-size:cover;}
.header{background:#111;color:white;padding:10px;}
.title{font-size:18px;font-weight:bold;}
.nav button{padding:0px 2px;margin-right:5px;}
#countdown{height:22px;line-height:22px;font-weight:bold;color:#007acc;}
table{border-collapse:collapse;width:100%;table-layout:fixed;background:#b4c7db;border:1px solid #000;}
th, td{border:1px solid #000;}
th{background:#222;color:white;padding:2px 4px;}
.cita{font-size:11px;margin:2px 0;padding:2px;border-left:3px solid #007acc;background:#e8f4ff;}
.hoy{background:#fff3a0;}
.badge{background:#007acc;color:white;padding:2px 5px;font-size:11px;display:inline-block;margin-top:3px;}
#logoPrincipal{position:absolute;right:10;width:80px;height:80px;object-fit:contain;}
#logoFooter{position:absolute;bottom:2;right:10;width:50px;height:50px;}
#autorFooter{position:absolute;bottom:15px;margin:0;font-size:9px;color:gray;}
.cita.primera{background:#8cf58c;border-left:3px solid #2e7d32;}
.cita.segunda{background:#c1dbc1;border-left:3px solid #555;}
.cita.sinvehiculo{background:#edb96f;border-left:3px solid #d4a000;}
#url{display:none;}
#btnSync{display:none;}
</style>

<script>

var DATOS = null;
var currentDate = new Date();
var INDEX = {};
var VEH_INDEX = {};

var SYNC_INTERVAL = 300;
var syncLeft = SYNC_INTERVAL;

/* ========================= */
/* ACTUALIZACIÓN AUTOMÁTICA  */
/* ========================= */

var URL_ACTUALIZACION =
    "https://raw.githubusercontent.com/X43K/ITVControl-cliente-offline/refs/heads/main/ITVOffline.hta";

var actualizacionEnCurso = false;
var ultimaComprobacionActualizacion = 0;

/* ========================= */
/* RUTAS DE ARCHIVOS         */
/* ========================= */

function getCachePath(){
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    return fso.GetParentFolderName(location.pathname) + "\\cache.xk";
}

function getConfigPath(){
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    return fso.GetParentFolderName(location.pathname) + "\\config.xk";
}

/* ========================= */
/* ACTUALIZADOR AUTOMÁTICO   */
/* ========================= */

function getRutaHTAActual(){
    try{
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        return fso.GetAbsolutePathName(location.pathname);
    }catch(e){
        return "";
    }
}

function getVersionLocal(){

    try{
        var titulo = document.title || "";
        var m = titulo.match(/ITVControl\s+ERP\s+([0-9]+(?:\.[0-9]+)*)/i);

        if(m && m[1]){
            return m[1];
        }

    }catch(e){}

    return "0";
}

function compararVersiones(v1, v2){

    try{

        var a = String(v1).split(".");
        var b = String(v2).split(".");

        var max = Math.max(a.length, b.length);

        for(var i = 0; i < max; i++){

            var n1 = parseInt(a[i] || "0", 10);
            var n2 = parseInt(b[i] || "0", 10);

            if(isNaN(n1)) n1 = 0;
            if(isNaN(n2)) n2 = 0;

            if(n1 > n2) return 1;
            if(n1 < n2) return -1;
        }

    }catch(e){}

    return 0;
}

function extraerVersionRemota(txt){

    try{

        var m = txt.match(/<title[^>]*>\s*ITVControl\s+ERP\s+([0-9]+(?:\.[0-9]+)*)\s*<\/title>/i);

        if(m && m[1]){
            return m[1];
        }

    }catch(e){}

    return "";
}

function escribirArchivoBinario(ruta, datos){

    try{

        var stream = new ActiveXObject("ADODB.Stream");

        stream.Type = 1;
        stream.Open();
        stream.Write(datos);
        stream.SaveToFile(ruta, 2);
        stream.Close();

        return true;

    }catch(e){

        try{
            if(stream) stream.Close();
        }catch(e2){}

        return false;
    }
}

function crearActualizadorVBScript(rutaVbs, rutaTemporal, rutaDestino){

    try{

        var fso = new ActiveXObject("Scripting.FileSystemObject");

        var q = String.fromCharCode(34);

        var vbs = "";

        vbs += "Option Explicit" + "\r\n";
        vbs += "Dim fso, shell, tempFile, targetFile, i" + "\r\n";
        vbs += "Set fso = CreateObject(" + q + "Scripting.FileSystemObject" + q + ")" + "\r\n";
        vbs += "Set shell = CreateObject(" + q + "WScript.Shell" + q + ")" + "\r\n";

        vbs += "tempFile = " + q + rutaTemporal.replace(/"/g, q + q) + q + "\r\n";
        vbs += "targetFile = " + q + rutaDestino.replace(/"/g, q + q) + q + "\r\n";

        vbs += "For i = 1 To 30" + "\r\n";

        vbs += "    WScript.Sleep 500" + "\r\n";

        vbs += "    On Error Resume Next" + "\r\n";

        vbs += "    If fso.FileExists(tempFile) Then" + "\r\n";
        vbs += "        fso.CopyFile tempFile, targetFile, True" + "\r\n";

        vbs += "        If Err.Number = 0 Then" + "\r\n";
        vbs += "            Exit For" + "\r\n";
        vbs += "        End If" + "\r\n";
        vbs += "        Err.Clear" + "\r\n";
        vbs += "    End If" + "\r\n";

        vbs += "    On Error GoTo 0" + "\r\n";

        vbs += "Next" + "\r\n";

        vbs += "On Error Resume Next" + "\r\n";

        vbs += "If fso.FileExists(tempFile) Then fso.DeleteFile tempFile, True" + "\r\n";

        vbs += "shell.Run " + q + "mshta.exe " + q + " & Chr(34) & targetFile & Chr(34), 1, False" + "\r\n";

        vbs += "WScript.Sleep 1000" + "\r\n";

        vbs += "If fso.FileExists(" + q + rutaVbs.replace(/"/g, q + q) + q + ") Then" + "\r\n";
        vbs += "    fso.DeleteFile " + q + rutaVbs.replace(/"/g, q + q) + q + ", True" + "\r\n";
        vbs += "End If" + "\r\n";

        var f = fso.CreateTextFile(rutaVbs, true);
        f.Write(vbs);
        f.Close();

        return true;

    }catch(e){

        return false;
    }
}

function iniciarActualizacion(rutaTemporal, versionNueva){

    try{

        var fso = new ActiveXObject("Scripting.FileSystemObject");

        var rutaActual = getRutaHTAActual();

        if(!rutaActual){
            return false;
        }

        var carpeta = fso.GetParentFolderName(rutaActual);

        var nombreBase = fso.GetBaseName(rutaActual);

        var rutaVbs =
            carpeta +
            "\\" +
            nombreBase +
            "_actualizador_" +
            new Date().getTime() +
            ".vbs";

        if(!crearActualizadorVBScript(
            rutaVbs,
            rutaTemporal,
            rutaActual
        )){
            return false;
        }

        actualizacionEnCurso = true;

        var shell = new ActiveXObject("WScript.Shell");

        shell.Run(
            "wscript.exe " + String.fromCharCode(34) + rutaVbs + String.fromCharCode(34),
            0,
            false
        );

        alert(
            "Se ha encontrado una nueva versión de ITVControl.\n\n" +
            "Versión actual: " + getVersionLocal() + "\n" +
            "Nueva versión: " + versionNueva + "\n\n" +
            "El programa se va a actualizar y reiniciar automáticamente."
        );

        window.close();

        return true;

    }catch(e){

        actualizacionEnCurso = false;

        return false;
    }
}

function comprobarActualizacion(){

    if(actualizacionEnCurso){
        return;
    }

    try{

        var ahora = new Date().getTime();

        /*
         * Evitamos que dos sincronizaciones simultáneas
         * lancen dos comprobaciones de GitHub.
         */
        if(ahora - ultimaComprobacionActualizacion < 10000){
            return;
        }

        ultimaComprobacionActualizacion = ahora;

        var versionLocal = getVersionLocal();

        var xhr = new ActiveXObject("MSXML2.XMLHTTP.6.0");

        var url =
            URL_ACTUALIZACION +
            (URL_ACTUALIZACION.indexOf("?") > -1 ? "&" : "?") +
            "t=" +
            new Date().getTime();

        xhr.open("GET", url, true);

        xhr.onreadystatechange = function(){

            if(xhr.readyState != 4){
                return;
            }

            try{

                if(xhr.status != 200 || !xhr.responseText){
                    return;
                }

                var txt = xhr.responseText;

                var versionRemota = extraerVersionRemota(txt);

                if(!versionRemota){
                    return;
                }

                /*
                 * Si GitHub tiene la misma versión o una inferior,
                 * no hacemos absolutamente nada.
                 */
                if(compararVersiones(versionRemota, versionLocal) <= 0){
                    return;
                }

                /*
                 * Ya tenemos una versión superior.
                 * La descargamos a un archivo temporal.
                 */

                var fso = new ActiveXObject("Scripting.FileSystemObject");

                var rutaActual = getRutaHTAActual();

                if(!rutaActual){
                    return;
                }

                var carpeta = fso.GetParentFolderName(rutaActual);

                var rutaTemporal =
                    carpeta +
                    "\\ITVOffline_update_" +
                    new Date().getTime() +
                    ".hta";

                if(!escribirArchivoBinario(
                    rutaTemporal,
                    xhr.responseBody
                )){
                    return;
                }

                /*
                 * Comprobamos que el archivo descargado
                 * parece realmente un HTA válido y que
                 * contiene la versión esperada.
                 */

                var check = fso.OpenTextFile(rutaTemporal, 1, false);
                var contenidoCheck = check.ReadAll();
                check.Close();

                var versionDescargada =
                    extraerVersionRemota(contenidoCheck);

                if(
                    !versionDescargada ||
                    compararVersiones(versionDescargada, versionLocal) <= 0
                ){

                    try{
                        fso.DeleteFile(rutaTemporal, true);
                    }catch(e1){}

                    return;
                }

                iniciarActualizacion(
                    rutaTemporal,
                    versionDescargada
                );

            }catch(e){

                /*
                 * Si falla la comprobación de actualización,
                 * no afecta al funcionamiento normal.
                 */

            }
        };

        xhr.send();

    }catch(e){

        /*
         * Sin Internet, GitHub caído, etc.
         * El programa continúa funcionando normalmente.
         */

    }
}

/* ========================= */
/* CLAVE DE SINCRONIZACIÓN   */
/* ========================= */

function cambiarClaveSync(){

    var clave = prompt("Nueva clave de sincronización:", "");
    if(clave == null) return;

    clave = clave.replace(/^\s+|\s+$/g, "");

    if(clave == ""){
        alert("No se ha introducido ninguna clave.");
        return;
    }

    var url = "http://www.LAWEB-o-IPSERVIDOR.com/itv/sync_offline.php?key=" + escape(clave);
    document.getElementById("url").value = url;

    try{
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var f = fso.CreateTextFile(getConfigPath(), true);
        f.Write(url);
        f.Close();
    }catch(e){}

    sincronizar();
}

/* ========================= */
/* CACHÉ                     */
/* ========================= */

function guardarCache(){
    try{
        if(!DATOS) return;
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var file = fso.CreateTextFile(getCachePath(), true);
        file.Write("DATOS=" + objToString(DATOS));
        file.Close();
    }catch(e){
        var el = document.getElementById("estado");
        if(el) el.innerHTML = "ERROR CACHE WRITE";
    }
}

function cargarCache(){
    try{
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var path = getCachePath();
        if(!fso.FileExists(path)) return false;
        var file = fso.OpenTextFile(path, 1);
        var txt = file.ReadAll();
        file.Close();
        if(!txt || txt.indexOf("DATOS=") == -1) return false;
        eval(txt);
        return (DATOS && DATOS.citas && DATOS.vehiculos);
    }catch(e){
        return false;
    }
}

/* ========================= */
/* SERIALIZACIÓN MANUAL      */
/* ========================= */

function objToString(obj){
    if(obj === null) return "null";
    if(typeof obj !== "object") return "'" + obj + "'";

    if(obj instanceof Array){
        var a = [];
        for(var i = 0; i < obj.length; i++){
            a.push(objToString(obj[i]));
        }
        return "[" + a.join(",") + "]";
    }

    var s = [];
    for(var k in obj){
        if(typeof obj[k] !== "function"){
            s.push("'" + k + "':" + objToString(obj[k]));
        }
    }
    return "{" + s.join(",") + "}";
}

/* ========================= */
/* FONDO DINÁMICO            */
/* ========================= */

function fondoOnline(){
    document.body.style.backgroundImage = "url('fonon.xk?t=" + new Date().getTime() + "')";
}

function fondoOffline(){
    document.body.style.backgroundImage = "url('fonof.xk')";
}

/* ========================= */
/* INICIO                    */
/* ========================= */

function start(){
    try{
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        if(fso.FileExists(getConfigPath())){
            var f = fso.OpenTextFile(getConfigPath(), 1);
            document.getElementById("url").value = f.ReadAll();
            f.Close();
        }
    }catch(e){}

    window.resizeTo(1050, 750);
    window.moveTo(-2, 4);

    if(cargarCache()){
        buildIndex();
        pintarCalendario();
        document.getElementById("estado").innerHTML = "CACHE OFFLINE";
    }

    sincronizar();

    /*
     * Comprobación de actualización al arrancar.
     * Se ejecuta unos segundos después para no interferir
     * con la carga inicial ni con la sincronización.
     */
    setTimeout(comprobarActualizacion, 5000);

    setInterval(sincronizar, SYNC_INTERVAL * 1000);
    setInterval(updateCountdown, 1000);
}


/* ========================= */
/* CUENTA ATRÁS SYNC         */
/* ========================= */

function updateCountdown(){
    syncLeft--;
    if(syncLeft <= 0) syncLeft = SYNC_INTERVAL;

    var el = document.getElementById("countdown");
    if(!el) return;

    var m = Math.floor(syncLeft / 60);
    var s = syncLeft % 60;
    el.innerHTML = "Próxima sync en: " + m + ":" + (s < 10 ? "0" : "") + s;
}

/* ========================= */
/* SINCRONIZACIÓN            */
/* ========================= */

function mostrarOffline(fechaSync){
    fondoOffline();
    var estado = document.getElementById("estado");
    if(!estado) return;
    estado.innerHTML =
        "<span style='color:#f20713;font-size:20px;font-weight:bold;'>OFFLINE</span>" +
        "<span style='display:inline-block;margin-left:10px;font-size:9px;color:gray;vertical-align:top;'>" +
            "Mostrando datos de CACHE<br>" +
            "Última sincronización: " + fechaSync +
        "</span>";
}

function getFechaSync(){
    if(!DATOS || !DATOS.fecha_sync) return "";
    return DATOS.fecha_sync.replace(/^(\d{4})-(\d{2})-(\d{2})/, "$3-$2-$1");
}

function sincronizar(){
    try{
        var xhr = new ActiveXObject("MSXML2.XMLHTTP.6.0");
        var url = document.getElementById("url").value;
        url += (url.indexOf("?") > -1 ? "&" : "?") + "t=" + new Date().getTime();

        xhr.open("GET", url, true);

        xhr.onreadystatechange = function(){
            if(xhr.readyState != 4) return;

            try{
                if(xhr.status != 200 || !xhr.responseText){
                    if(cargarCache()){ buildIndex(); pintarCalendario(); }
                    mostrarOffline(getFechaSync());
                    return;
                }

                var txt = xhr.responseText;
                if(txt.length < 50 || txt.indexOf("citas") == -1){
                    if(cargarCache()){ buildIndex(); pintarCalendario(); }
                    fondoOffline();
                    var estado = document.getElementById("estado");
                    if(estado) estado.innerHTML = "<span style='color:orange;font-weight:bold;'>OFFLINE CACHE</span>";
                    return;
                }

                DATOS = eval("(" + txt + ")");
                guardarCache();
                buildIndex();
                syncLeft = SYNC_INTERVAL;

                var estado = document.getElementById("estado");
                if(estado) estado.innerHTML = "<span style='color:#07f207;font-size:20px;font-weight:bold;'>ONLINE</span>";

                fondoOnline();
                pintarCalendario();
				
                comprobarActualizacion();

            }catch(e){
                if(cargarCache()){ buildIndex(); pintarCalendario(); }
                mostrarOffline(getFechaSync());
            }
        };

        xhr.send();

    }catch(e){
        if(cargarCache()){ buildIndex(); pintarCalendario(); }
        mostrarOffline(getFechaSync());
    }
}

/* ========================= */
/* ÍNDICES                   */
/* ========================= */

function normDate(f){
    if(!f) return "";
    /* Antes: return f.split(" ")[0];
       Problema: si fecha_cita trae espacios sobrantes, caracteres
       invisibles (NBSP, etc.) u otro formato al principio, split(" ")[0]
       podia devolver "" o basura, y la cita se indexaba bajo una clave
       que el calendario nunca consulta (se queda invisible en su celda).
       Ahora: extraemos el patron AAAA-MM-DD este donde este dentro de
       la cadena, ignorando cualquier caracter sobrante alrededor. */
    var m = ("" + f).match(/\d{4}-\d{2}-\d{2}/);
    return m ? m[0] : "";
}

function buildIndex(){
    INDEX = {};
    VEH_INDEX = {};
    if(!DATOS) return;

    for(var i = 0; i < DATOS.citas.length; i++){
        var c = DATOS.citas[i];
        var d = normDate(c.fecha_cita);
        if(!d) continue;
        if(!INDEX[d]) INDEX[d] = [];
        INDEX[d].push(c);
    }

    for(var j = 0; j < DATOS.vehiculos.length; j++){
        VEH_INDEX[DATOS.vehiculos[j].matricula] = DATOS.vehiculos[j];
    }
}


/* ========================= */
/* CALENDARIO                */
/* ========================= */

function cambiarMes(n){
    currentDate.setMonth(currentDate.getMonth() + n);
    pintarCalendario();
}

function pintarCalendario(){

    var el = document.getElementById("citas");
    if(!el || !DATOS) return;

    var y = currentDate.getFullYear();
    var m = currentDate.getMonth();

    var first = new Date(y, m, 1);
    var last  = new Date(y, m + 1, 0);
    var dias  = last.getDate();

    var start = first.getDay();
    if(start == 0) start = 7;

    var meses = ["Enero","Febrero","Marzo","Abril","Mayo","Junio",
                 "Julio","Agosto","Septiembre","Octubre","Noviembre","Diciembre"];

    var hoy = new Date();
    hoy.setHours(0, 0, 0, 0);
    var hoyStr = hoy.getFullYear() + "-" +
                 ("0" + (hoy.getMonth() + 1)).slice(-2) + "-" +
                 ("0" + hoy.getDate()).slice(-2);

    var ahora      = new Date();
    var anoActual  = ahora.getFullYear();
    var mesActual  = ahora.getMonth();

    var html = "";

    html += "<div class='header'><div class='title'>MES VISUALIZADO</div>";
    html += "<div>" + meses[m] + " " + y + "</div>";
    html += "<div id='countdown'></div></div>";

    html += "<div class='nav'>";
    html += "<button onclick='cambiarMes(-1)'>Mes -</button>";
    html += "<button onclick='cambiarMes(1)'>Mes +</button>";
    html += "<button onclick='sincronizar()'>Sync</button>";
    html += "</div>";

    html += "<table><tr><th>Lun</th><th>Mar</th><th>Mie</th><th>Jue</th><th>Vie</th><th>Sab</th><th>Dom</th></tr><tr>";

    var day = 1;

    for(var i = 1; i <= 42; i++){

        if(i >= start && day <= dias){

            var dateStr = y + "-" +
                          ("0" + (m + 1)).slice(-2) + "-" +
                          ("0" + day).slice(-2);

            var cell = "<b>" + day + "</b>";
            var list = INDEX[dateStr];

            if(list){
                for(var k = 0; k < list.length; k++){

                    var c = list[k];

                    if(c.hora_cita){
                        var partes   = c.fecha_cita.split(" ")[0].split("-");
                        var hora     = c.hora_cita.split(":");
                        var citaDate = new Date(
                            parseInt(partes[0], 10),
                            parseInt(partes[1], 10) - 1,
                            parseInt(partes[2], 10),
                            parseInt(hora[0], 10),
                            parseInt(hora[1], 10)
                        );
                        var diffMin = (ahora - citaDate) / 60000;

                        // Ocultar meses anteriores al actual
                        if(y < anoActual || (y == anoActual && m < mesActual)) continue;

                        // En el mes actual, ocultar citas de hace más de 1 hora
                        if(y == anoActual && m == mesActual && diffMin > 60) continue;
                    }

                    var v          = VEH_INDEX[c.vehiculo];
                    var nombre     = v ? v.vehiculo : c.vehiculo;
                    var esSegunda  = (c.tipo_cita == "Segunda");
                    var sinVehiculo = (!c.vehiculo || c.vehiculo.replace(/^\s+|\s+$/g, "") == "");

                    var clase    = sinVehiculo ? "sinvehiculo" : (esSegunda ? "segunda" : "primera");
                    var vehTexto = sinVehiculo ? "SIN VEHICULO" : nombre;

                    cell += "<div class='cita " + clase + "'>"
                          + c.hora_cita + " - "
                          + vehTexto + " - "
                          + c.estacion_cita + " "
                          + (esSegunda ? "2" : "1")
                          + "</div>";
                }
            }

            html += "<td" + (dateStr == hoyStr ? " class='hoy'" : "") + ">" + cell + "</td>";
            day++;

        }else{
            html += "<td></td>";
        }

        if(i % 7 == 0) html += "</tr><tr>";
    }

    html += "</tr></table>";

    html += alertaCaducidades();

    el.innerHTML = html;
}

function tieneCitaITV(matricula){

    if(!DATOS || !DATOS.citas) return false;

    var hoy = new Date();
    hoy.setHours(0,0,0,0);

    for(var i=0;i<DATOS.citas.length;i++){

        var c = DATOS.citas[i];

        if(c.vehiculo != matricula) continue;

        var f = normDate(c.fecha_cita);
        if(!f) continue;

        var p = f.split("-");
        var fecha = new Date(
            parseInt(p[0],10),
            parseInt(p[1],10)-1,
            parseInt(p[2],10)
        );

        fecha.setHours(0,0,0,0);

        // Sólo cuentan citas de hoy o futuras
        if(fecha >= hoy){
            return true;
        }
    }

    return false;
}

function alertaCaducidades(){

    if(!DATOS || !DATOS.vehiculos) return "";

    var hoy = new Date();
    hoy.setHours(0,0,0,0);

    var lista = [];
    var rechazadas = [];

    for(var i=0;i<DATOS.vehiculos.length;i++){

        var v = DATOS.vehiculos[i];

        // 🔴 RECHAZADAS
        if(v.estado && v.estado.replace(/^\s+|\s+$/g,"")=="ITV RECHAZADA"){
            rechazadas.push({
                matricula:v.matricula,
                vehiculo:v.vehiculo,
                flota:v.flota
            });
        }

        // 🟡 CADUCIDAD
        if(!v.caducidad_itv) continue;
        if(v.estado!="ACTIVO") continue;

        var p = v.caducidad_itv.split("-");
        if(p.length!=3) continue;

        var fecha = new Date(
            parseInt(p[0],10),
            parseInt(p[1],10)-1,
            parseInt(p[2],10)
        );

        fecha.setHours(0,0,0,0);

        var dias = Math.floor((fecha-hoy)/86400000);

        // Mostrar también las ya caducadas
        if(dias<=20){
            lista.push({
                dias:dias,
                matricula:v.matricula,
                vehiculo:v.vehiculo,
                flota:v.flota,
                fecha:v.caducidad_itv
            });
        }
    }

    lista.sort(function(a,b){ return a.dias-b.dias; });

    var html="";

    /* ===================== */
    /* 🔴 LISTA RECHAZADAS   */
    /* ===================== */
    html+="<div style='margin-top:10px;padding:6px;border:1px solid #999;background:transparent;font-size:12px;'>";

    html+="<div style='font-size:16px;font-weight:bold;color:#b00000;margin-bottom:5px;'>";
    html+="ITVs RECHAZADAS";
    html+="</div>";

    if(rechazadas.length==0){
        html+="<div style='color:green;font-weight:bold;'>No hay ITVs rechazadas</div>";
    }else{
        for(var i=0;i<rechazadas.length;i++){
            var r = rechazadas[i];

            html+="<div style='background:#ff8a8a;padding:5px;margin-bottom:3px;border-left:6px solid #b00000;'>";
            html+="<b>"+r.matricula+"</b> &nbsp; "+r.vehiculo+" ("+r.flota+")";
            html+=" &nbsp; <b style='color:#b00000;'>ITV RECHAZADA</b>";
            html+="</div>";
        }
    }

    html+="</div>";


    /* ===================== */
    /* 🟡 LISTA CADUCIDAD    */
    /* ===================== */
    html+="<div style='margin-top:10px;padding:6px;border:1px solid #999;background:transparent;font-size:12px;'>";

    html+="<div style='font-size:16px;font-weight:bold;margin-bottom:5px;'>";
    html+="ITVs CADUCADAS Y QUE CADUCAN EN LOS PRÓXIMOS 20 DÍAS";
    html+="</div>";

    if(lista.length==0){
        html+="<div style='color:green;font-weight:bold;'>No hay vehículos próximos a caducar</div>";
    }else{

        for(var i=0;i<lista.length;i++){
            var c=lista[i];

            var color="#fff27a";
            if(c.dias<=5) color="#ff8a8a";
            else if(c.dias<=7) color="#ffd07a";

            html+="<div style='background:"+color+";padding:5px;margin-bottom:4px;border-left:6px solid red;'>";
            html+="<b>"+c.matricula+"</b> &nbsp; "+c.vehiculo+" ("+c.flota+")";
            html+=" &nbsp; Caduca el <b>"+c.fecha+"</b>";
            html+=" &nbsp; <span style='color:#b00000;font-weight:bold'>";
            if(c.dias < 0){
                html+="CADUCADA HACE "+(-c.dias)+" DIAS";
            }
            else if(c.dias==0){
                html+="HOY";
            }
            else if(c.dias==1){
                html+="MAÑANA";
            }
            else{
                html+="EN "+c.dias+" DIAS";
            }
            html+="</span>";
			
			if(!tieneCitaITV(c.matricula)){
    html+="<br><span style='display:inline-block;background:#ffeb3b;color:#000;border:2px solid #000;padding:2px 8px;font-weight:bold;font-size:13px;'>";
    html+="⚠ SIN CITA ITV ASIGNADA";
    html+="</span>";
}

            html+="</div>";
        }
    }

    html+="</div>";

    return html;
}

</script>

</head>

<body onload="start()">

<h2 style="margin-bottom:6px;">
    Datos obtenidos de ITVControl
    <img id="logoPrincipal" src="itvg-512.xk">
</h2>

<div style="display:flex;align-items:center;gap:12px;margin-bottom:6px;">
    <p id="estado" style="margin:0;">Conectando...</p>

    <input id="url" size="80" value="" />
    <button id="btnSync" onclick="sincronizar()">Sync ahora</button>
    <button onclick="cambiarClaveSync()">Cambiar clave Sync</button>
</div>

<hr style="margin-top:4px;">

<div id="citas"></div>

<p id="autorFooter">B174M3 // XaeK</p>
<img id="logoFooter" src="l.xk">

</body>

</html>
